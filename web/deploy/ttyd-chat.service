[Unit]
Description=TTY.js Terminal Web Server for C Chat Client
Documentation=https://github.com/tsl0741/ttyd
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/chat

ExecStart=/usr/bin/ttyd -p 7681 -W /opt/chat/chat-client

Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ttyd-chat

Environment="TERM=xterm-256color"

[Install]
WantedBy=multi-user.target